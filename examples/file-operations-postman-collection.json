          "response": []
        },
        {
          "name": "Copy Folder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"targetParentId\": \"parent-folder-id-to-copy-to\",\n    \"newName\": \"new-folder-name\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/files/copy/folder/{{folderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "files",
                "copy",
                "folder",
                "{{folderId}}"
              ]
            },
            "description": "Copy a folder to a different parent folder with a new name"
          },
          "response": []
        }
