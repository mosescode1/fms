  "item": [
    {
      "name": "Authentication",
      "description": "Endpoints for authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login as an admin user to get an authentication token"
          },
          "response": []
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/member/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "member",
                "login"
              ]
            },
            "description": "Login as a regular user to get an authentication token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Move Operations",
      "description": "Endpoints for moving files and folders",
      "item": [
        {
          "name": "Move File",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"newFolderId\": \"folder-id-to-move-to\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/files/move/file/{{fileId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "files",
                "move",
                "file",
                "{{fileId}}"
              ]
            },
            "description": "Move a file to a different folder"
          },
          "response": []
        },
        {
          "name": "Move Folder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"newParentId\": \"parent-folder-id-to-move-to\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/files/move/folder/{{folderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "files",
                "move",
                "folder",
                "{{folderId}}"
              ]
            },
            "description": "Move a folder to a different parent folder"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Copy Operations",
      "description": "Endpoints for copying files and folders",
      "item": [
        {
          "name": "Copy File",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"targetFolderId\": \"folder-id-to-copy-to\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v2/files/copy/file/{{fileId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "files",
                "copy",
                "file",
                "{{fileId}}"
              ]
            },
            "description": "Copy a file to a different folder"
